# Minimal PypeIt input file used by the dashboard's CI-safe header tests.
# It carries only the configuration metadata the header banner needs
# (spectrograph + setup); it is NOT a runnable reduction and requires no
# raw data.  Generated by JXP and Claude.

[rdx]
    spectrograph = shane_kast_blue

setup read
Setup A:
  dispname: 600/4310
setup end

data read
 path /tmp
                 filename | frametype
 b1.fits.gz |  arc,tilt
data end
