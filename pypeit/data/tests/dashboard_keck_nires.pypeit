# Minimal PypeIt input file for the dashboard's CI-safe echelle tests.
# It carries only the configuration metadata the dashboard needs
# (spectrograph + setup) for keck_nires (an Echelle pipeline); it is NOT a
# runnable reduction and requires no raw data.  Generated by JXP and Claude.

[rdx]
    spectrograph = keck_nires

setup read
Setup A:
setup end

data read
 path /tmp
                 filename | frametype
 s1.fits |  arc,tilt,science
data end
